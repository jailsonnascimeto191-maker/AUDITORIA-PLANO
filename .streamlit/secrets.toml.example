# Modelo dos "Secrets" do Streamlit Cloud (Settings → Secrets).
# NÃO coloque os valores reais neste arquivo: ele vai para o GitHub.
# Copie as linhas abaixo para a tela de Secrets e troque pelos seus dados.

# Banco permanente (Supabase → Connect → Session pooler). Troque [SUA-SENHA] pela senha do banco.
DATABASE_URL = "postgresql://postgres.xxxxxxxxxxxx:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha inicial do usuário "admin" (usada só quando o banco ainda não tem administrador).
ADMIN_PASSWORD = "troque-por-uma-senha-forte-123"
